{
  "expo": {
    "name": "YOYO LIVE",
    "slug": "yoyo-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "YOYO LIVE يستخدم الكاميرا لبدء البث المباشر.",
        "NSMicrophoneUsageDescription": "YOYO LIVE يستخدم الميكروفون لنقل صوت البث المباشر."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.yoyolive.app",
      "versionCode": 1,
      "label": "YOYO LIVE"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "يويو لايف",
      "shortName": "YOYO LIVE",
      "lang": "ar",
      "dir": "rtl",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": ".",
      "backgroundColor": "#0B0912",
      "themeColor": "#0B0912",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/yoyo-live"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "اسمح ليويو لايف باستخدام الكاميرا لبدء البث المباشر.",
          "microphonePermission": "اسمح ليويو لايف باستخدام الميكروفون لنقل صوت البث المباشر."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36
          }
        }
      ]
    ]
  }
}
