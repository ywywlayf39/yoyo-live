
import React, { useState } from 'react';
import {
  View,
    Text,
      StyleSheet,
        ScrollView,
          TouchableOpacity,
            SafeAreaView,
              StatusBar,
              } from 'react-native';

              const C = {
                bg: '#0B0912',
                  card: '#191424',
                    card2: '#241B35',
                      purple: '#8655F5',
                        pink: '#F34E9B',
                          white: '#FFFFFF',
                            muted: '#AAA1B8',
                              gold: '#F5C451',
                              };

                              const people = [
                                { name: 'سارة', emoji: '👩🏻' },
                                  { name: 'أحمد', emoji: '🧔🏻' },
                                    { name: 'نور', emoji: '👩🏼' },
                                      { name: 'محمد', emoji: '👨🏻' },
                                        { name: 'ليلى', emoji: '👩🏽' },
                                        ];

                                        const videos = [
                                          { emoji: '🎬', name: 'ياسمين', desc: 'أجمل لحظات اليوم ✨', views: '12.5K' },
                                            { emoji: '🎤', name: 'عمر', desc: 'مين صاحي معانا؟ 🔥', views: '8.2K' },
                                              { emoji: '🌸', name: 'نور', desc: 'يوم جميل مع YOYO', views: '5.7K' },
                                              ];

                                              export default function App() {
                                                const [selectedLive, setSelectedLive] = useState(null);

                                                  if (selectedLive) {
                                                      return (
                                                            <SafeAreaView style={styles.container}>
                                                                    <StatusBar barStyle="light-content" backgroundColor={C.bg} />
                                                                            <View style={styles.roomHeader}>
                                                                                      <TouchableOpacity onPress={() => setSelectedLive(null)}>
                                                                                                  <Text style={styles.back}>رجوع ←</Text>
                                                                                                            </TouchableOpacity>
                                                                                                                      <Text style={styles.live}>● LIVE</Text>
                                                                                                                              </View>
                                                                                                                                      <View style={styles.room}>
                                                                                                                                                <Text style={styles.roomEmoji}>{selectedLive.emoji}</Text>
                                                                                                                                                          <Text style={styles.roomName}>{selectedLive.name}</Text>
                                                                                                                                                                    <Text style={styles.roomDesc}>
                                                                                                                                                                                مرحباً بك في بث {selectedLive.name} 💗
                                                                                                                                                                                          </Text>
                                                                                                                                                                                                    <Text style={styles.roomViewers}>👥 250 مشاهد</Text>
                                                                                                                                                                                                              <Text style={styles.demo}>غرفة بث تجريبية</Text>
                                                                                                                                                                                                                      </View>
                                                                                                                                                                                                                              <View style={styles.roomActions}>
                                                                                                                                                                                                                                        <TouchableOpacity style={styles.action}>
                                                                                                                                                                                                                                                    <Text style={styles.actionText}>💬 الدردشة</Text>
                                                                                                                                                                                                                                                              </TouchableOpacity>
                                                                                                                                                                                                                                                                        <TouchableOpacity style={styles.action}>
                                                                                                                                                                                                                                                                                    <Text style={styles.actionText}>🎁 هدية</Text>
                                                                                                                                                                                                                                                                                              </TouchableOpacity>
                                                                                                                                                                                                                                                                                                        <TouchableOpacity style={styles.action}>
                                                                                                                                                                                                                                                                                                                    <Text style={styles.actionText}>❤️ إعجاب</Text>
                                                                                                                                                                                                                                                                                                                              </TouchableOpacity>
                                                                                                                                                                                                                                                                                                                                      </View>
                                                                                                                                                                                                                                                                                                                                            </SafeAreaView>
                                                                                                                                                                                                                                                                                                                                                );
                                                                                                                                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                                                                                                                                    return (
                                                                                                                                                                                                                                                                                                                                                        <SafeAreaView style={styles.container}>
                                                                                                                                                                                                                                                                                                                                                              <StatusBar barStyle="light-content" backgroundColor={C.bg} />

                                                                                                                                                                                                                                                                                                                                                                    <ScrollView showsVerticalScrollIndicator={false}>
                                                                                                                                                                                                                                                                                                                                                                            <View style={styles.header}>
                                                                                                                                                                                                                                                                                                                                                                                      <View>
                                                                                                                                                                                                                                                                                                                                                                                                  <Text style={styles.logo}>
                                                                                                                                                                                                                                                                                                                                                                                                                YOYO <Text style={{ color: C.pink }}>LIVE</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                            </Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                        <Text style={styles.subtitle}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                      عالمك .. لحظتك .. جمهورك
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <View style={styles.headerIcons}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Text style={styles.coins}>🪙 250</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <Text style={styles.notification}>🔔</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </View>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <View style={styles.sectionHeader}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Text style={styles.more}>← عرض الكل</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <Text style={styles.sectionTitle}>المباشر الآن 🔴</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </View>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <ScrollView horizontal showsHorizontalScrollIndicator={false}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {people.map((person, i) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <TouchableOpacity
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                key={i}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              style={styles.story}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            onPress={() => setSelectedLive(person)}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        >
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <View style={styles.storyCircle}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Text style={styles.storyEmoji}>{person.emoji}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Text style={styles.storyName}>{person.name}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <Text style={styles.live}>● LIVE</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </TouchableOpacity>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </ScrollView>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <TouchableOpacity style={styles.arena}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <Text style={styles.arenaEmoji}>🏆</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <Text style={styles.arenaTitle}>YOYO ARENA</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <Text style={styles.arenaDesc}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                التحدي بدأ.. مين نجم الساحة النهارده؟
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <Text style={styles.arenaLink}>ادخل التحدي ←</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </TouchableOpacity>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <View style={styles.sectionHeader}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <Text style={styles.more}>المزيد ←</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <Text style={styles.sectionTitle}>اكتشف الفيديوهات ✨</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </View>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {videos.map((video, i) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <View key={i} style={styles.videoCard}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <Text style={styles.videoEmoji}>{video.emoji}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <View style={styles.videoInfo}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <Text style={styles.videoName}>{video.name}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Text style={styles.videoDesc}>{video.desc}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <Text style={styles.views}>▶ {video.views} مشاهدة</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </ScrollView>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <View style={styles.bottomNav}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {['الرئيسية', 'اكتشف', 'البث', 'الرسائل', 'حسابي'].map((item, i) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <TouchableOpacity key={i} style={styles.navItem}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <Text style={styles.navIcon}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {['🏠', '✨', '🔴', '💬', '👤'][i]}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Text style={styles.navText}>{item}</Text>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </TouchableOpacity>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </View>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </SafeAreaView>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                );
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const styles = StyleSheet.create({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  container: {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      flex: 1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          backgroundColor: C.bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              header: {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  padding: 18,
